# =============================================================================
# TRACE INTEL — Environment Configuration Template
# Never commit real API keys or secrets to version control.
# =============================================================================

# Local Storage Mode: "sqlite" (local file data/trace_intel.sqlite with in-memory fallback) or "memory"
TRACE_INTEL_STORAGE="sqlite"

# Server-Side Session Signing Secret (recommended 32+ random hex chars)
SESSION_SECRET=

# Google Gemini API Key (server-side only via @google/genai; never exposed to browser)
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_MS="28000"

# Optional Frontend API Base URL (leave empty when frontend and /api run on the same origin)
VITE_API_BASE_URL=

# Optional comma-separated list of allowed CORS origins when frontend and backend are deployed separately
ALLOWED_ORIGINS=

# Optional External OTP Provider Webhook URL (only if two-step OTP delivery is enabled)
OTP_PROVIDER_WEBHOOK_URL=
OTP_PROVIDER_WEBHOOK_SECRET=

# Application Host URL
APP_URL=
